<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.HotelRes_App" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.HotelRes_App" parent="Base.Theme.HotelRes_App" />

    <style name="MaterialCalendarTheme" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSurface">@color/white</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:windowFullscreen">false</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <style name="CalendarDayStyle" parent="Widget.MaterialComponents.MaterialCalendar.Day">
        <item name="android:textColor">@android:color/black</item>
    </style>

    <style name="PositiveButtonStyle" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="NegativeButtonStyle" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="DatePickerTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorAccent">@color/primary</item>
        <item name="android:textColor"> @android:color/black</item>
        <item name="colorControlNormal">@color/primary</item>
        <item name="android:textColorSecondary">@color/primary</item>
        <item name="android:windowFullscreen">false</item>

        <item name="android:buttonBarPositiveButtonStyle">@style/PositiveButtonStyle</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/NegativeButtonStyle</item>
    </style>
</resources>